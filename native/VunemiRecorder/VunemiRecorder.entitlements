<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The meeting recorder's entitlements, and only what it uses: the
  microphone, under the hardened runtime. System audio comes through a
  Core Audio process tap, which macOS guards with its own permission and no
  entitlement.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
